# Copy this file to home-it.env (same folder as server.js), fill in what you use,
# then restart:  systemctl --user restart home-it
# Leave a line empty to keep that feature off. Never commit home-it.env or paste its keys anywhere.

# Your time zone, so "today" and the night hours match your clock (a list: en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Toronto
# Where the app listens
PORT=8100

# ---- Sign-in extras, the same as Split it ----
# The address people open, used in email links and Google sign-in. No slash at the end.
PUBLIC_URL=https://your-laptop.your-tailnet.ts.net
# Emails (check your email, forgot password), from resend.com
RESEND_API_KEY=
MAIL_FROM=Home it <hello@yourdomain.com>
# "Continue with Google", from console.cloud.google.com (OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The owner's page asks GitHub whether a newer Home it is out (nothing about you is sent).
# Write off to stop that.
UPDATE_CHECK=
